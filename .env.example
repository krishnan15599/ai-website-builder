# OpenRouter (recommended) — https://openrouter.ai/keys
USE_MOCK_AI=false
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter metadata
# OPENROUTER_APP_NAME=Aetheria Website Builder
# OPENROUTER_SITE_URL=http://localhost:3000

# Demo mode (no API) — set USE_MOCK_AI=true and remove OPENROUTER_API_KEY

# Legacy OpenAI (optional fallback if OPENROUTER_API_KEY is unset)
# OPENAI_API_KEY=sk-your-key-here
